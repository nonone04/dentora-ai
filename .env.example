# Supabase
# Project URL and anon (public) key — found in Supabase Dashboard > Project Settings > API.
# NEXT_PUBLIC_ vars are exposed to the browser; only put the anon key here, never the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses Row Level Security. Never expose to the client
# or prefix with NEXT_PUBLIC_. Used for privileged/admin server-side operations only.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (see supabase/config.toml's [auth.external.google], used by `supabase start`
# for local dev). Create the OAuth client in Google Cloud Console with an authorized redirect
# URI of `<SUPABASE_PROJECT_URL>/auth/v1/callback` (add one entry per environment: the local
# Supabase URL, and the hosted project URL used by both localhost:3000 and dentora.vip -- the
# app's own callback at /auth/callback is dynamic and needs no separate registration). For the
# hosted project, set the client ID/secret in Supabase Dashboard > Authentication > Providers >
# Google instead of here, and add http://localhost:3000/** and https://dentora.vip/** to
# Authentication > URL Configuration > Redirect URLs.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Notifications / email (see lib/notifications/provider.ts and lib/email/).
# RESEND_API_KEY + EMAIL_FROM are optional: without both set, notification
# "sends" just log to the server console instead of delivering for real.
RESEND_API_KEY=
# Must include the Dentora AI display name, e.g.:
#   EMAIL_FROM="Dentora AI <hello@dentora.vip>"
# The hello@dentora.vip domain must be a verified sending domain in the
# Resend dashboard before this works.
EMAIL_FROM=

# Signing secret for Supabase Auth's "Send Email" hook
# (app/api/auth/send-email-hook/route.ts) -- lets our own branded Resend
# templates fully replace Supabase's default Verify Email / Password Reset /
# Staff Invitation emails. Generated when you enable the hook in Supabase
# Dashboard > Authentication > Hooks > Send Email, pointed at
# `<your deployed app origin>/api/auth/send-email-hook`. Format is
# `v1,whsec_<base64>` -- paste it verbatim.
SUPABASE_AUTH_HOOK_SECRET=

# Support inbox address shown in every branded email's footer
# (lib/email/components.ts's renderFooter). Falls back to support@dentora.ai
# if unset.
EMAIL_SUPPORT=

# Public base URL used for the website/privacy/terms links in every
# branded email's footer. Falls back to https://dentora.ai if unset.
NEXT_PUBLIC_APP_URL=

# Shared secret Vercel Cron (or any external scheduler) must present as
# `Authorization: Bearer <value>` to call /api/notifications/process.
CRON_SECRET=

# AI orchestration
# Optional: without this, the AI orchestrator uses a scripted mock LLM
# client instead of calling Anthropic for real (see lib/ai/llm/).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Shared secret required as `Authorization: Bearer <value>` to call the
# internal /api/ai/debug-orchestrate test harness. Not a public endpoint.
AI_DEBUG_SECRET=

# WhatsApp (Meta Cloud API) -- see app/api/whatsapp/webhook/route.ts.
# Optional: without WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID,
# outbound WhatsApp sends fall back to the logging notification provider.
# WHATSAPP_VERIFY_TOKEN: arbitrary string you choose and enter in the Meta
#   App dashboard's webhook subscription form.
# WHATSAPP_APP_SECRET: Meta App secret, used to verify the
#   X-Hub-Signature-256 header on inbound webhook requests.
# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: used to send messages
#   via the Graph API (one phone_number_id per Dentora deployment).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Stripe (see lib/stripe/server.ts and app/actions/billing.ts).
# Secret key from Stripe Dashboard > Developers > API keys -- server-only,
# never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Price ids (not product ids) for the "standard" and "professional" plans,
# from Stripe Dashboard > Product catalog. The client only ever sends the
# plan name ("standard"/"professional"); the server maps it to one of these.
STRIPE_STANDARD_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=

# Product analytics (see docs/product-analytics.md and lib/telemetry/).
# Comma-separated allowlist of Dentora-team emails permitted to view the
# internal cross-clinic dashboard at /admin/analytics. Case-insensitive.
# Without this set, the dashboard 404s for everyone.
ANALYTICS_ADMIN_EMAILS=
