# Supabase
# Project URL and anon (public) key — found in Supabase Dashboard > Project Settings > API.
# NEXT_PUBLIC_ vars are exposed to the browser; only put the anon key here, never the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses Row Level Security. Never expose to the client
# or prefix with NEXT_PUBLIC_. Used for privileged/admin server-side operations only.
SUPABASE_SERVICE_ROLE_KEY=

# Notifications
# Optional: without these, notification "sends" just log to the server console
# instead of delivering for real (see lib/notifications/provider.ts).
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Shared secret Vercel Cron (or any external scheduler) must present as
# `Authorization: Bearer <value>` to call /api/notifications/process.
CRON_SECRET=

# AI orchestration
# Optional: without this, the AI orchestrator uses a scripted mock LLM
# client instead of calling Anthropic for real (see lib/ai/llm/).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Shared secret required as `Authorization: Bearer <value>` to call the
# internal /api/ai/debug-orchestrate test harness. Not a public endpoint.
AI_DEBUG_SECRET=

# WhatsApp (Meta Cloud API) -- see app/api/whatsapp/webhook/route.ts.
# Optional: without WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID,
# outbound WhatsApp sends fall back to the logging notification provider.
# WHATSAPP_VERIFY_TOKEN: arbitrary string you choose and enter in the Meta
#   App dashboard's webhook subscription form.
# WHATSAPP_APP_SECRET: Meta App secret, used to verify the
#   X-Hub-Signature-256 header on inbound webhook requests.
# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: used to send messages
#   via the Graph API (one phone_number_id per Dentora deployment).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
